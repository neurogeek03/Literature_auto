# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
#
# The pipeline reads exactly two environment variables, both from your Slack
# app (Socket Mode). Everything else is configured in config.yaml, not here.
# See README.md ("Setup") for how to create the Slack app and obtain each token.

# Slack Bot User OAuth Token — starts with `xoxb-`.
# Slack app → OAuth & Permissions → Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token with the `connections:write` scope — starts with `xapp-`.
# Slack app → Basic Information → App-Level Tokens (required for Socket Mode).
SLACK_APP_TOKEN=xapp-your-app-level-token

# --- NOT environment variables --------------------------------------------------
# Google Drive OAuth (optional `drive` extra) is NOT configured here. It uses two
# JSON files in the repo root, both gitignored, created outside this file:
#   credentials.json  — Desktop OAuth client downloaded from Google Cloud Console
#   token.json        — written automatically on first authenticated Drive run
# Crossref/Unpaywall contact emails live in config.yaml (metadata.crossref_mailto,
# metadata.unpaywall_email), not here.
